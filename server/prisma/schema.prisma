generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  aiApiKey     String?
  sessions     Session[]
  transactions Transaction[]
  categories   Category[]
  budgets      Budget[]      // Добавили связь с бюджетами
  notes        Note[]        // Твои заметки из UI тоже надо хранить в БД
}

model Session {
  id           String   @id @default(uuid())
  refreshToken String   @unique
  userAgent    String?
  ip           String?
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  expiresAt    DateTime
}

model Category {
  id           String        @id @default(uuid())
  name         String
  type         String        // "income" или "expense"
  icon         String?       // Для кастомизации (FaPlus, FaFood и т.д.)
  color        String?       // Hex-код цвета для графиков
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budget       Budget?       // Связь с лимитом
}

model Transaction {
  id         String   @id @default(uuid())
  amount     Decimal  @db.Decimal(12, 2) // Точные деньги: до 10 млрд с 2 знаками
  type       String   
  desc       String?
  date       DateTime @db.Date // Лучше хранить как нативный Date для адекватных запросов
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  createdAt  DateTime @default(now())

  @@index([userId, date]) // Ускоряет фильтрацию по датам
}

model Budget {
  id         String   @id @default(uuid())
  amount     Decimal  @db.Decimal(12, 2)
  categoryId String   @unique
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}